{%- liquid
  assign words = section.settings.typed_words | split: ','
  assign word_list = ''
  for w in words
    assign word_list = word_list | append: w | strip | append: '|'
  endfor
-%}
<section class="section search-hero color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.image != blank -%}
    <div class="search-hero__bg" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: '' }}
    </div>
  {%- endif -%}
  <div class="page-width">
    <div class="search-hero__inner reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="search-hero__title heading-italic">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="search-hero__text rte">{{ section.settings.text }}</div>{%- endif -%}

      <div class="search-hero__form" data-open="SearchModal" role="button" tabindex="0" aria-label="{{ 'general.search.title' | t }}">
        {% render 'icon', icon: 'search' %}
        <span class="search-hero__fake">
          {{ section.settings.placeholder }} <typed-text class="search-hero__typed" data-words="{{ word_list | escape }}"></typed-text>
        </span>
        <span class="btn btn--primary"><span>{{ 'general.search.submit' | t }}</span>{% render 'icon', icon: 'arrow-right' %}</span>
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="chips search-hero__chips" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- assign url = block.settings.link -%}
              {%- if url == blank -%}{%- assign url = block.settings.label | url_for_vendor -%}{%- endif -%}
              <a href="{{ url }}" class="chip">{{ block.settings.label }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_stats -%}
        <div class="search-hero__stats">
          {%- if section.settings.stat_1 != blank -%}<span>{% render 'icon', icon: 'double-check' %}{{ section.settings.stat_1 }}</span>{%- endif -%}
          {%- if section.settings.stat_2 != blank -%}<span>{% render 'icon', icon: 'video' %}{{ section.settings.stat_2 }}</span>{%- endif -%}
          {%- if section.settings.stat_3 != blank -%}<span>{% render 'icon', icon: 'return' %}{{ section.settings.stat_3 }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Search hero",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay", "label": "Background veil", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 75 },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Certified pre-owned" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "What are you <em>looking</em> for?", "info": "Wrap words in italics to highlight them." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Thousands of authenticated designer pieces, graded with care and ready to ship.</p>" },
    { "type": "text", "id": "placeholder", "label": "Search prompt", "default": "Try" },
    { "type": "text", "id": "typed_words", "label": "Animated suggestions", "default": "a quilted shoulder bag, a silk scarf, a card holder, a gold bracelet", "info": "Comma separated." },
    { "type": "checkbox", "id": "show_stats", "label": "Show trust line", "default": true },
    { "type": "text", "id": "stat_1", "label": "Trust item 1", "default": "Authenticated twice" },
    { "type": "text", "id": "stat_2", "label": "Trust item 2", "default": "Every inspection filmed" },
    { "type": "text", "id": "stat_3", "label": "Trust item 3", "default": "14-day returns" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "shortcut",
      "name": "Designer shortcut",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Designer" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to link to all products by this designer (vendor)." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Search hero",
      "blocks": [
        { "type": "shortcut", "settings": { "label": "Chanel" } },
        { "type": "shortcut", "settings": { "label": "Louis Vuitton" } },
        { "type": "shortcut", "settings": { "label": "Hermès" } },
        { "type": "shortcut", "settings": { "label": "Gucci" } },
        { "type": "shortcut", "settings": { "label": "Prada" } },
        { "type": "shortcut", "settings": { "label": "Dior" } }
      ]
    }
  ]
}
{% endschema %}
