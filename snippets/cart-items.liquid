{%- comment -%} Cart line items, shared by drawer and page. Param: context ('drawer' | 'page') {%- endcomment -%}
<ul class="cart-items cart-items--{{ context }}" role="list">
  {%- for item in cart.items -%}
    {%- capture condition -%}{% render 'product-condition', product: item.product %}{%- endcapture -%}
    <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,300', sizes: '120px', alt: item.title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
      <div class="cart-item__info">
        {%- if item.vendor != blank -%}<p class="cart-item__vendor">{{ item.vendor }}</p>{%- endif -%}
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__meta">
            {%- for option in item.options_with_values -%}{{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
          </p>
        {%- endunless -%}
        {%- if condition != blank -%}<p class="cart-item__meta">{{ 'products.product.condition_label' | t }}: {{ condition }}</p>{%- endif -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__meta">{{ property.first }}: {{ property.last }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}<p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
        <div class="cart-item__price">
          {%- if item.original_line_price != item.final_line_price -%}
            <s class="price__compare">{% render 'money', amount: item.original_line_price %}</s>
            <span class="price__current price__current--sale">{% render 'money', amount: item.final_line_price %}</span>
          {%- else -%}
            <span class="price__current">{% render 'money', amount: item.final_line_price %}</span>
          {%- endif -%}
        </div>
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{% render 'icon', icon: 'tag' %} {{ discount.discount_application.title }} (&minus;{% render 'money', amount: discount.amount %})</p>
        {%- endfor -%}
        <div class="cart-item__controls">
          {%- assign max_qty = '' -%}
          {%- if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' -%}
            {%- assign max_qty = item.variant.inventory_quantity -%}
          {%- endif -%}
          {%- if max_qty == 1 -%}
            <span class="cart-item__unique">{{ 'products.product.one_of_one' | t }}</span>
          {%- else -%}
            {% render 'quantity-input', value: item.quantity, min: 0, max: max_qty, line: forloop.index, label: item.title %}
          {%- endif -%}
          <button type="button" class="cart-item__remove link-underline" data-cart-remove="{{ forloop.index }}" aria-label="{{ 'cart.general.remove_title' | t: title: item.title | escape }}">
            {{ 'cart.general.remove' | t }}
          </button>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
