<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- assign b = section.settings.blog -%}
    {% render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, link_label: section.settings.link_label, link_url: b.url %}
    <div class="grid" style="--cols: {{ section.settings.columns }}; --cols-mobile: 1;">
      {%- if b != blank and b.articles_count > 0 -%}
        {%- for article in b.articles limit: section.settings.limit -%}
          {% render 'article-card', article: article %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="article-card">
            <div class="media">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <p class="article-card__meta">{{ 'blogs.general.journal' | t }}</p>
            <h3 class="article-card__title">{{ 'blogs.article.placeholder' | t }}</h3>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal posts",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The journal" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Stories & <em>buying guides</em>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the journal" },
    { "type": "range", "id": "limit", "label": "Posts", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "Journal posts" } ]
}
{% endschema %}
