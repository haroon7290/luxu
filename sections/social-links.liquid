<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {% render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text, align: 'center' %}
    {%- if section.settings.style == 'tiles' -%}
      {% render 'social-icons', class: 'social--tiles', show_labels: true %}
    {%- else -%}
      <div style="display: flex; justify-content: center;">{% render 'social-icons', class: 'social--lg' %}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="social-feed">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: settings.social_instagram | default: '#' }}" target="_blank" rel="noopener" class="social-feed__item reveal" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <div class="media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,500', sizes: '(min-width: 990px) 16vw, 33vw' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            {% render 'icon', icon: block.settings.icon, class: 'social-feed__icon' %}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Social links",
  "tag": "div",
  "disabled_on": { "groups": ["header"] },
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "Links come from Theme settings › Social media." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
    { "type": "select", "id": "style", "label": "Style", "default": "tiles", "options": [ { "value": "tiles", "label": "Tiles" }, { "value": "icons", "label": "Icons" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Follow along" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Unboxings, live drops & <em>behind the scenes</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Feed image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Hover icon", "default": "instagram", "options": [ { "value": "instagram", "label": "Instagram" }, { "value": "tiktok", "label": "TikTok" }, { "value": "youtube", "label": "YouTube" }, { "value": "play", "label": "Play" } ] }
      ]
    }
  ],
  "presets": [ { "name": "Social links" } ]
}
{% endschema %}
