<site-popup id="Popup-{{ section.id }}" class="modal popup{% if section.settings.image != blank %} popup--image{% endif %}" aria-hidden="true" data-id="{{ section.id }}" data-delay="{{ section.settings.delay }}" data-days="{{ section.settings.frequency }}" data-exit="{{ section.settings.exit_intent }}">
  <div class="modal__overlay" data-close></div>
  <div class="modal__panel color-{{ section.settings.color_scheme }}" role="dialog" aria-modal="true" aria-labelledby="PopupTitle-{{ section.id }}" tabindex="-1">
    <button type="button" class="modal__close icon-btn" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
    {%- if section.settings.image != blank -%}
      <div class="popup__media">{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,900', sizes: '420px' }}</div>
    {%- endif -%}
    <div class="popup__body">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2" id="PopupTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
      {%- form 'customer', id: 'PopupForm', class: 'form-stack' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,popup">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success">{% render 'icon', icon: 'check' %} {{ 'newsletter.success' | t }}</p>
          {%- if section.settings.code != blank -%}
            <button type="button" class="popup__code" data-copy="{{ section.settings.code }}">{{ section.settings.code }} {% render 'icon', icon: 'copy' %}</button>
          {%- endif -%}
        {%- else -%}
          <div class="field">
            <input type="email" name="contact[email]" id="PopupEmail" class="field__input" autocomplete="email" placeholder=" " required>
            <label for="PopupEmail" class="field__label">{{ 'newsletter.email' | t }}</label>
          </div>
          <button type="submit" class="btn btn--primary btn--full">{{ section.settings.button_label }}</button>
          {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      {%- if section.settings.disclaimer != blank -%}<p class="newsletter__disclaimer">{{ section.settings.disclaimer }}</p>{%- endif -%}
    </div>
  </div>
</site-popup>

{% schema %}
{
  "name": "Newsletter popup",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Welcome" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your first find, a little lighter" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Join for early access to new arrivals and a welcome code for your first order.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Unlock my code" },
    { "type": "text", "id": "code", "label": "Discount code shown after sign-up", "default": "WELCOME20" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Unsubscribe any time. See our privacy policy." },
    { "type": "range", "id": "delay", "label": "Show after", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 10 },
    { "type": "range", "id": "frequency", "label": "Show again after", "min": 1, "max": 60, "step": 1, "unit": "d", "default": 14 },
    { "type": "checkbox", "id": "exit_intent", "label": "Also show on exit intent (desktop)", "default": true }
  ],
  "presets": [ { "name": "Newsletter popup" } ]
}
{% endschema %}
