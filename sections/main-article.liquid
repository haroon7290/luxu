<article class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width page-width--narrow">
    <header class="article__header">
      <p class="eyebrow eyebrow--line"><a href="{{ blog.url }}">{{ blog.title }}</a></p>
      <h1 class="h1">{{ article.title }}</h1>
      <p class="article-card__meta">
        <span>{{ article.published_at | time_tag: format: 'date' }}</span>
        {%- if section.settings.show_author and article.author != blank -%}<span>{{ 'blogs.article.by' | t: author: article.author }}</span>{%- endif -%}
      </p>
    </header>
  </div>
  {%- if article.image and section.settings.show_image -%}
    <div class="page-width page-width--medium article__hero">
      <div class="media">{{ article.image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '750,1100,1500,2200', sizes: '(min-width: 1100px) 1100px, 100vw', alt: article.image.alt | escape }}</div>
    </div>
  {%- endif -%}
  <div class="page-width page-width--narrow">
    <div class="rte article__body">{{ article.content }}</div>
    <footer class="article__footer">
      {%- if article.tags.size > 0 -%}
        <ul class="chips" role="list">{%- for tag in article.tags -%}<li><a class="chip" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a></li>{%- endfor -%}</ul>
      {%- endif -%}
      <button type="button" class="link-arrow" data-share data-title="{{ article.title | escape }}">{% render 'icon', icon: 'share' %} {{ 'general.share' | t }}</button>
    </footer>

    {%- if blog.comments_enabled? -%}
      <div class="comments">
        <h2 class="h3">{{ 'blogs.comments.title' | t: count: article.comments_count }}</h2>
        {%- paginate article.comments by 20 -%}
          {%- for comment in article.comments -%}
            <div class="comment">
              <div class="rte">{{ comment.content }}</div>
              <p class="comment__meta">{{ comment.author }} · {{ comment.created_at | time_tag: format: 'date' }}</p>
            </div>
          {%- endfor -%}
          {% render 'pagination', paginate: paginate, style: 'numbers' %}
        {%- endpaginate -%}
        {%- form 'new_comment', article, class: 'form-stack' -%}
          <h3 class="h4">{{ 'blogs.comments.leave' | t }}</h3>
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success">{% if blog.moderated? %}{{ 'blogs.comments.success_moderated' | t }}{% else %}{{ 'blogs.comments.success' | t }}{% endif %}</p>
          {%- endif -%}
          {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="form-row">
            <div class="field"><input class="field__input" type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" placeholder=" " required><label class="field__label" for="CommentAuthor">{{ 'blogs.comments.name' | t }}</label></div>
            <div class="field"><input class="field__input" type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" placeholder=" " required><label class="field__label" for="CommentEmail">{{ 'blogs.comments.email' | t }}</label></div>
          </div>
          <div class="field"><textarea class="field__input" name="comment[body]" id="CommentBody" rows="5" placeholder=" " required>{{ form.body }}</textarea><label class="field__label" for="CommentBody">{{ 'blogs.comments.message' | t }}</label></div>
          {%- if blog.moderated? -%}<p class="muted" style="font-size: var(--fs-xs);">{{ 'blogs.comments.moderated' | t }}</p>{%- endif -%}
          <button type="submit" class="btn btn--primary">{{ 'blogs.comments.post' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</article>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
    {%- if article.image -%},"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif %}
  }
</script>

{% schema %}
{
  "name": "Blog post",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_image", "label": "Show featured image", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 88 }
  ]
}
{% endschema %}
