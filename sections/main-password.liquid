<div class="password color-{{ section.settings.color_scheme }}" style="background: var(--c-gradient, var(--c-bg));{% if section.settings.image != blank %} background-image: linear-gradient(rgba(var(--c-bg-rgb), .82), rgba(var(--c-bg-rgb), .82)), url({{ section.settings.image | image_url: width: 2400 }}); background-size: cover; background-position: center;{% endif %}">
  <header style="padding: 2rem; display: flex; justify-content: center;">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, style: 'width: 160px' }}
    {%- else -%}
      <span class="header__logo-text">{{ shop.name }}</span>
    {%- endif -%}
  </header>
  <main class="password__main">
    <div class="password__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h0 heading-italic">{{ section.settings.heading }}</h1>
      {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'customer', class: 'newsletter__form password-modal' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="field">
            <input type="email" name="contact[email]" id="PasswordNewsletter" class="field__input" placeholder=" " required>
            <label for="PasswordNewsletter" class="field__label">{{ 'newsletter.email' | t }}</label>
          </div>
          <button type="submit" class="btn btn--primary">{{ 'password.notify' | t }}</button>
        {%- endif -%}
      {%- endform -%}
      <details class="password__admin">
        <summary class="link-underline">{{ 'password.enter_password' | t }}</summary>
        {%- form 'storefront_password', class: 'newsletter__form password-modal' -%}
          {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field">
            <input type="password" name="password" id="StorePassword" class="field__input" autocomplete="current-password" placeholder=" " required>
            <label for="StorePassword" class="field__label">{{ 'password.password' | t }}</label>
          </div>
          <button type="submit" class="btn btn--secondary">{{ 'password.enter' | t }}</button>
        {%- endform -%}
      </details>
      {% render 'social-icons' %}
    </div>
  </main>
  <footer class="password__footer">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>{{ 'password.admin_link_html' | t: link: '/admin' }}</span>
    <span>{{ powered_by_link }}</span>
  </footer>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Opening soon" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Something <em>beautiful</em> is on its way" }
  ]
}
{% endschema %}
