<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {% render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text %}
    <div class="promo-grid" style="--cols: {{ section.settings.columns }}; --tile-ratio: {{ section.settings.ratio }};">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="promo-tile zoom-on-hover reveal{% if block.settings.wide %} promo-tile--wide{% endif %}" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <div class="media"{% if block.settings.wide %} style="--ratio: calc(var(--tile-ratio) / 2);"{% endif %}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500,800,1100,1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.image.alt }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 2 | plus: 1 -%}
              {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="promo-tile__overlay"></div>
          <div class="promo-tile__content">
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            <h3 class="promo-tile__title heading-italic">{{ block.settings.heading }}</h3>
            {%- if block.settings.label != blank -%}<span class="link-arrow">{{ block.settings.label }} {% render 'icon', icon: 'arrow-right' %}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo tiles",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "select", "id": "ratio", "label": "Tile ratio", "default": "1.1", "options": [ { "value": "0.75", "label": "Landscape" }, { "value": "1", "label": "Square" }, { "value": "1.1", "label": "Slightly tall" }, { "value": "1.3", "label": "Portrait" } ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Under €800" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Finds that <em>feel</em> like a find" },
        { "type": "text", "id": "label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "wide", "label": "Span two columns", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo tiles",
      "blocks": [
        { "type": "tile", "settings": { "eyebrow": "Under €800", "heading": "Finds that <em>feel</em> like a find" } },
        { "type": "tile", "settings": { "eyebrow": "Signature pieces", "heading": "An icon, <em>your</em> next chapter" } }
      ]
    }
  ]
}
{% endschema %}
