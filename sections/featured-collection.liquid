{%- liquid
  assign tabs = section.blocks | where: 'type', 'tab'
  if tabs.size == 0
    assign first_url = section.settings.collection.url
  else
    assign first_url = tabs.first.settings.collection.url
  endif
-%}
<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <tabs-component>
      {%- capture tab_buttons -%}
        {%- if tabs.size > 1 -%}
          <div class="tabs" role="tablist">
            {%- for block in tabs -%}
              <button type="button" class="tabs__btn" role="tab" id="Tab-{{ block.id }}" aria-controls="Panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
                {{ block.settings.label | default: block.settings.collection.title }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endcapture -%}
      {% render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text, link_label: section.settings.link_label, link_url: first_url, extra: tab_buttons %}

      {%- if tabs.size > 0 -%}
        {%- for block in tabs -%}
          <div class="tabs__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel" id="Panel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
            <ul class="grid product-grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }};">
              {%- for product in block.settings.collection.products limit: section.settings.limit -%}
                <li class="reveal" style="--i: {{ forloop.index0 | modulo: 4 }};">{% render 'product-card', product: product %}</li>
              {%- else -%}
                {%- for i in (1..4) -%}<li>{% render 'product-card', index: i %}</li>{%- endfor -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      {%- else -%}
        <ul class="grid product-grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }};">
          {%- for product in section.settings.collection.products limit: section.settings.limit -%}
            <li class="reveal" style="--i: {{ forloop.index0 | modulo: 4 }};">{% render 'product-card', product: product %}</li>
          {%- else -%}
            {%- for i in (1..section.settings.limit) -%}<li>{% render 'product-card', index: i %}</li>{%- endfor -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </tabs-component>
    {%- if section.settings.button_label != blank -%}
      <div class="text-center mt-3"><a href="{{ first_url | default: routes.all_products_collection_url }}" class="btn btn--secondary">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Fresh from inspection" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "New <em>arrivals</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used when no tabs are added." },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 24, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "default": "2", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "text", "id": "link_label", "label": "Header link label", "default": "View all" },
    { "type": "text", "id": "button_label", "label": "Button below" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [ { "name": "Product grid" } ]
}
{% endschema %}
