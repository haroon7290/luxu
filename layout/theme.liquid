<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- for scheme in settings.color_schemes limit: 1 -%}
      <meta name="theme-color" content="{{ scheme.settings.background }}">
    {%- endfor -%}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {%- if settings.font_source == 'google' -%}
      {%- assign g_head = settings.google_heading_font | default: 'Cormorant Garamond' | strip -%}
      {%- assign g_body = settings.google_body_font | default: 'Jost' | strip -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ g_head | replace: ' ', '+' }}:{{ settings.google_heading_axes | default: 'wght@400' | strip }}&display=swap">
      {%- if g_body != g_head -%}
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ g_body | replace: ' ', '+' }}:{{ settings.google_body_axes | default: 'wght@400' | strip }}&display=swap">
      {%- endif -%}
      {%- capture font_heading -%}"{{ g_head }}", "Cormorant", Georgia, "Times New Roman", serif{%- endcapture -%}
      {%- capture font_body -%}"{{ g_body }}", "Helvetica Neue", Arial, sans-serif{%- endcapture -%}
    {%- else -%}
      {%- capture font_heading -%}{{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }}{%- endcapture -%}
      {%- capture font_body -%}{{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}{%- endcapture -%}
    {%- endif -%}

    {%- style -%}
      {%- if settings.font_source == 'shopify' -%}
        {{ settings.type_header_font | font_face: font_display: 'swap' }}
        {{ settings.type_body_font | font_face: font_display: 'swap' }}
        {%- assign body_medium = settings.type_body_font | font_modify: 'weight', '500' -%}
        {%- assign body_bold = settings.type_body_font | font_modify: 'weight', 'bold' -%}
        {%- assign body_italic = settings.type_body_font | font_modify: 'style', 'italic' -%}
        {{ body_medium | font_face: font_display: 'swap' }}
        {{ body_bold | font_face: font_display: 'swap' }}
        {{ body_italic | font_face: font_display: 'swap' }}
      {%- endif -%}

      :root {
        --font-heading: {{ font_heading }};
        --font-body: {{ font_body }};
        --heading-weight: {{ settings.heading_weight }};
        --heading-transform: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};
        --eyebrow-transform: {% if settings.eyebrow_uppercase %}uppercase{% else %}none{% endif %};
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.border_radius }}px;
        --btn-radius: {{ settings.button_radius }}px;
        --btn-transform: {% if settings.button_uppercase %}uppercase{% else %}none{% endif %};
        --card-ratio: {{ settings.card_image_ratio }};
        --card-fit: {{ settings.card_image_fit }};
        --card-pad: {{ settings.card_image_padding }}%;
        --c-sale: {{ settings.color_sale }};
        --c-success: {{ settings.color_success }};
        --c-live: {{ settings.color_live }};
        --logo-width: {{ settings.logo_width }}px;
        --logo-width-mobile: {{ settings.logo_width_mobile }}px;
      }

      {% for scheme in settings.color_schemes -%}
        {%- assign s = scheme.settings -%}
        {% if forloop.first %}:root,{% endif %}
        .color-{{ scheme.id }} {
          --c-bg: {{ s.background }};
          --c-bg-rgb: {{ s.background.red }}, {{ s.background.green }}, {{ s.background.blue }};
          --c-gradient: {% if s.background_gradient != blank %}{{ s.background_gradient }}{% else %}{{ s.background }}{% endif %};
          --c-text: {{ s.text }};
          --c-text-rgb: {{ s.text.red }}, {{ s.text.green }}, {{ s.text.blue }};
          --c-accent: {{ s.accent }};
          --c-accent-rgb: {{ s.accent.red }}, {{ s.accent.green }}, {{ s.accent.blue }};
          --c-surface: {{ s.surface }};
          --c-btn: {{ s.button }};
          --c-btn-label: {{ s.button_label }};
          --c-btn-2: {{ s.secondary_button_label }};
          {%- if s.background.lightness < 45 %}
          --scheme-dark: 1;
          {%- endif %}
        }
      {%- endfor %}
    {%- endstyle -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        settings: {
          cartType: {{ settings.cart_type | json }},
          moneyFormat: {{ shop.money_format | json }},
          moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
          showCurrencyCode: {{ settings.currency_code_enabled | json }},
          freeShippingThreshold: {{ settings.free_shipping_threshold | default: 0 | times: 100 | json }},
          predictiveSearch: {{ settings.predictive_search_enabled | json }},
          wishlistEnabled: {{ settings.wishlist_enabled | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          adding: {{ 'products.product.adding' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          copied: {{ 'general.copied' | t | json }},
          saved: {{ 'wishlist.added' | t | json }},
          removed: {{ 'wishlist.removed' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          freeShippingAway: {{ 'cart.general.free_shipping_away' | t: amount: '[amount]' | json }},
          freeShippingReached: {{ 'cart.general.free_shipping_reached' | t | json }},
          discountInvalid: {{ 'cart.general.discount_invalid' | t | json }},
          wishlistEmpty: {{ 'wishlist.empty' | t | json }},
          days: {{ 'sections.countdown.days' | t | json }},
          hours: {{ 'sections.countdown.hours' | t | json }},
          minutes: {{ 'sections.countdown.minutes' | t | json }},
          seconds: {{ 'sections.countdown.seconds' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}{% if settings.animations_reveal %} has-reveal{% endif %}{% if settings.animations_hover %} has-hover-zoom{% endif %}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- render 'search-modal' -%}
    {%- unless customer -%}
      {%- render 'account-drawer' -%}
    {%- endunless -%}
    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    <modal-dialog id="QuickView" class="modal modal--quick-view" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t }}">
      <div class="modal__overlay" data-close></div>
      <div class="modal__panel color-scheme-1">
        <button type="button" class="modal__close icon-btn" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
        <div class="modal__content" data-quick-view-content></div>
      </div>
    </modal-dialog>

    <div class="toast" role="status" aria-live="polite" data-toast></div>

    {%- if settings.show_back_to_top -%}
      <button type="button" class="back-to-top icon-btn" data-back-to-top aria-label="{{ 'accessibility.back_to_top' | t }}">
        {% render 'icon', icon: 'arrow-up' %}
      </button>
    {%- endif -%}
  </body>
</html>
