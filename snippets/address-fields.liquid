{%- comment -%} Address form fields. Params: form, id {%- endcomment -%}
{%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
<div class="form-row">
  <div class="field"><input class="field__input" type="text" id="AddrFirst-{{ id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder=" "><label class="field__label" for="AddrFirst-{{ id }}">{{ 'customer.register.first_name' | t }}</label></div>
  <div class="field"><input class="field__input" type="text" id="AddrLast-{{ id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder=" "><label class="field__label" for="AddrLast-{{ id }}">{{ 'customer.register.last_name' | t }}</label></div>
</div>
<div class="field"><input class="field__input" type="text" id="AddrCompany-{{ id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder=" "><label class="field__label" for="AddrCompany-{{ id }}">{{ 'customer.addresses.company' | t }}</label></div>
<div class="field"><input class="field__input" type="text" id="Addr1-{{ id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder=" "><label class="field__label" for="Addr1-{{ id }}">{{ 'customer.addresses.address1' | t }}</label></div>
<div class="field"><input class="field__input" type="text" id="Addr2-{{ id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder=" "><label class="field__label" for="Addr2-{{ id }}">{{ 'customer.addresses.address2' | t }}</label></div>
<div class="form-row">
  <div class="field"><input class="field__input" type="text" id="AddrCity-{{ id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder=" "><label class="field__label" for="AddrCity-{{ id }}">{{ 'customer.addresses.city' | t }}</label></div>
  <div class="field"><input class="field__input" type="text" id="AddrZip-{{ id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" autocapitalize="characters" placeholder=" "><label class="field__label" for="AddrZip-{{ id }}">{{ 'customer.addresses.zip' | t }}</label></div>
</div>
<div class="form-row">
  <div class="select" style="width: 100%;">
    <label class="visually-hidden" for="AddrCountry-{{ id }}">{{ 'customer.addresses.country' | t }}</label>
    <select id="AddrCountry-{{ id }}" name="address[country]" data-default="{{ form.country }}" style="width: 100%;">{{ all_country_option_tags }}</select>
    {% render 'icon', icon: 'chevron-down', class: 'select__caret' %}
  </div>
  <div class="field"><input class="field__input" type="text" id="AddrProvince-{{ id }}" name="address[province]" value="{{ form.province }}" autocomplete="address-level1" placeholder=" "><label class="field__label" for="AddrProvince-{{ id }}">{{ 'customer.addresses.province' | t }}</label></div>
</div>
<div class="field"><input class="field__input" type="tel" id="AddrPhone-{{ id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder=" "><label class="field__label" for="AddrPhone-{{ id }}">{{ 'contact.form.phone' | t }}</label></div>
<label class="check">
  {{ form.set_as_default_checkbox }}
  <span class="check__label">{{ 'customer.addresses.set_default' | t }}</span>
</label>
<button type="submit" class="btn btn--primary">{{ 'customer.addresses.save' | t }}</button>
<script>
  (function () {
    var sel = document.getElementById('AddrCountry-{{ id }}');
    if (sel && sel.dataset.default) { sel.value = sel.dataset.default; }
  })();
</script>
