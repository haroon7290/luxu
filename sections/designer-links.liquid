<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {% render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text, align: section.settings.align %}
    <div class="designers designers--{{ section.settings.style }}">
      <ul class="designers__list" role="list" style="--cols: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign url = block.settings.link
            if url == blank
              assign url = block.settings.name | url_for_vendor
            endif
          -%}
          <li class="reveal" style="--i: {{ forloop.index0 | modulo: 6 }};" {{ block.shopify_attributes }}>
            {%- case section.settings.style -%}
              {%- when 'cards' -%}
                <a href="{{ url }}" class="designer-card zoom-on-hover">
                  <div class="media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(min-width: 990px) 16vw, 50vw', alt: block.settings.name }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <span class="designer-card__name">{{ block.settings.name }}</span>
                </a>
              {%- when 'logos' -%}
                <a href="{{ url }}" class="designer-logo" aria-label="{{ block.settings.name | escape }}">
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.name }}
                  {%- else -%}
                    <span>{{ block.settings.name }}</span>
                  {%- endif -%}
                </a>
              {%- else -%}
                <a href="{{ url }}" class="designers__link">{{ block.settings.name }}{% if block.settings.note != blank %}<sup>{{ block.settings.note }}</sup>{% endif %}</a>
            {%- endcase -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.button_label != blank -%}
        <div class="designers__footer"><a href="{{ section.settings.button_link | default: '/pages/designers' }}" class="link-arrow">{{ section.settings.button_label }} {% render 'icon', icon: 'arrow-right' %}</a></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by designer",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 24,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "style", "label": "Style", "default": "text", "options": [ { "value": "text", "label": "Large type" }, { "value": "cards", "label": "Image cards" }, { "value": "logos", "label": "Logo grid" } ] },
    { "type": "range", "id": "columns", "label": "Columns (cards & logos)", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The houses" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shop by <em>designer</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "align", "label": "Heading alignment", "default": "center", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ] },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "All designers A–Z" },
    { "type": "url", "id": "button_link", "label": "Link", "info": "Defaults to /pages/designers (create a page with the page.brands template)." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "designer",
      "name": "Designer",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Designer" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to link to all products by this vendor." },
        { "type": "text", "id": "note", "label": "Superscript note", "info": "e.g. a product count or “New”" },
        { "type": "image_picker", "id": "image", "label": "Image (cards style)" },
        { "type": "image_picker", "id": "logo", "label": "Logo (logo style)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by designer",
      "blocks": [
        { "type": "designer", "settings": { "name": "Louis Vuitton" } },
        { "type": "designer", "settings": { "name": "Chanel" } },
        { "type": "designer", "settings": { "name": "Gucci" } },
        { "type": "designer", "settings": { "name": "Dior" } },
        { "type": "designer", "settings": { "name": "Loewe" } },
        { "type": "designer", "settings": { "name": "Prada" } }
      ]
    }
  ]
}
{% endschema %}
