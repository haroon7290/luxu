{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', icon: 'bag', class: 'icon--lg' %}
{%- endcomment -%}
{%- liquid
  assign cls = 'icon icon-' | append: icon
  if class
    assign cls = cls | append: ' ' | append: class
  endif
-%}
