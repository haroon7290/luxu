<section class="color-{{ section.settings.color_scheme }}" style="background: var(--c-gradient, var(--c-bg)); color: var(--c-text); padding-block: {{ section.settings.padding }}px;">
  <div class="marquee{% if section.settings.size == 'small' %} marquee--small{% endif %}" style="--marquee-speed: {{ section.settings.speed }}s;" role="marquee">
    <div class="marquee__track">
      {%- for i in (1..2) -%}
        <div class="marquee__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- for r in (1..2) -%}
              <span class="marquee__item" {% if forloop.first and i == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
              </span>
              {% render 'icon', icon: section.settings.separator, class: 'marquee__sep' %}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scrolling text",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "size", "label": "Text size", "default": "large", "options": [ { "value": "large", "label": "Large serif" }, { "value": "small", "label": "Small caps" } ] },
    { "type": "select", "id": "separator", "label": "Separator", "default": "sparkle", "options": [ { "value": "sparkle", "label": "Sparkle" }, { "value": "diamond", "label": "Diamond" }, { "value": "star", "label": "Star" }, { "value": "check", "label": "Check" } ] },
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 40 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    { "type": "text", "name": "Text", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Authenticated twice" }, { "type": "url", "id": "link", "label": "Link" } ] }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [
        { "type": "text", "settings": { "text": "Authenticated twice" } },
        { "type": "text", "settings": { "text": "Graded with care" } },
        { "type": "text", "settings": { "text": "Every inspection filmed" } },
        { "type": "text", "settings": { "text": "Pre-owned, never second best" } }
      ]
    }
  ]
}
{% endschema %}
