<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {% render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text, align: section.settings.align %}
    <div class="columns columns--{{ section.settings.align }} columns--{{ section.settings.style }}" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="column reveal" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media" style="--ratio: {{ section.settings.image_ratio }};">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,600,900', sizes: '(min-width: 990px) 33vw, 100vw' }}</div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="column__icon">{% render 'icon', icon: block.settings.icon %}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="column__title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="column__text rte">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.link_label != blank -%}<a href="{{ block.settings.link }}" class="link-arrow">{{ block.settings.link_label }} {% render 'icon', icon: 'arrow-right' %}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Why shop <em>with us</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ] },
    { "type": "select", "id": "style", "label": "Style", "default": "plain", "options": [ { "value": "plain", "label": "Plain" }, { "value": "cards", "label": "Cards" } ] },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "0.75", "options": [ { "value": "0.75", "label": "Landscape" }, { "value": "1", "label": "Square" }, { "value": "1.25", "label": "Portrait" } ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "none", "label": "None" }, { "value": "shield", "label": "Shield" }, { "value": "double-check", "label": "Double check" }, { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" },
          { "value": "lock", "label": "Lock" }, { "value": "gift", "label": "Gift" }, { "value": "diamond", "label": "Diamond" }, { "value": "leaf", "label": "Leaf" }, { "value": "chat", "label": "Chat" },
          { "value": "globe", "label": "Globe" }, { "value": "video", "label": "Video" }, { "value": "certificate", "label": "Certificate" }, { "value": "box", "label": "Box" }, { "value": "clock", "label": "Clock" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "star", "label": "Star" }, { "value": "check", "label": "Check" }, { "value": "tag", "label": "Tag" }, { "value": "return", "label": "Return" }, { "value": "loupe", "label": "Magnifier" } ] },
        { "type": "image_picker", "id": "image", "label": "Image (replaces icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Column" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pair text with an icon or image.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "icon": "shield", "title": "Authenticity guaranteed", "text": "<p>Full refund if an item is ever found not to be genuine.</p>" } },
        { "type": "column", "settings": { "icon": "truck", "title": "Insured delivery", "text": "<p>Tracked, insured and signed for — duties shown upfront.</p>" } },
        { "type": "column", "settings": { "icon": "return", "title": "14-day returns", "text": "<p>Changed your mind? Send it back within 14 days.</p>" } },
        { "type": "column", "settings": { "icon": "leaf", "title": "A circular choice", "text": "<p>Choosing pre-owned keeps beautiful things in use for longer.</p>" } }
      ]
    }
  ]
}
{% endschema %}
