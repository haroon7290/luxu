{%- paginate search.results by section.settings.per_page -%}
  {%- capture clear_url -%}{{ routes.search_url }}?q={{ search.terms | url_encode }}&options%5Bprefix%5D=last{%- endcapture -%}
  {%- capture empty_html -%}
    <div class="empty-state">
      <span class="empty-state__icon">{% render 'icon', icon: 'search', class: 'icon--lg' %}</span>
      {%- if search.performed -%}
        <p class="h3">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        <p class="muted">{{ 'general.search.no_results_text' | t }}</p>
      {%- else -%}
        <p class="h3">{{ 'general.search.start' | t }}</p>
      {%- endif -%}
      {%- assign shortcuts = settings.search_shortcuts | split: ',' -%}
      <ul class="chips" role="list" style="justify-content: center;">
        {%- for name in shortcuts -%}{%- assign n = name | strip -%}<li><a class="chip" href="{{ n | url_for_vendor }}">{{ n }}</a></li>{%- endfor -%}
      </ul>
    </div>
  {%- endcapture -%}
  <section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <div class="page-width">
      <div class="collection-hero" style="margin-bottom: 2rem;">
        <p class="eyebrow eyebrow--line">{{ 'general.search.title' | t }}</p>
        <h1 class="collection-hero__title">
          {%- if search.performed -%}{{ 'general.search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'general.search.title' | t }}{%- endif -%}
        </h1>
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
          <input type="hidden" name="options[prefix]" value="last">
          <div class="field">
            <input type="search" name="q" id="SearchPageInput" class="field__input" value="{{ search.terms | escape }}" placeholder=" " autocomplete="off">
            <label for="SearchPageInput" class="field__label">{{ 'general.search.placeholder' | t }}</label>
          </div>
          <button type="submit" class="btn btn--primary">{% render 'icon', icon: 'search' %}<span class="visually-hidden">{{ 'general.search.submit' | t }}</span></button>
        </form>
      </div>
      {% render 'product-grid-layout', results: search, paginate: paginate, section: section, clear_url: clear_url, empty_html: empty_html %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "default": "2", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "checkbox", "id": "enable_density", "label": "Let shoppers change columns", "default": true },
    { "type": "select", "id": "pagination", "label": "Pagination", "default": "load_more", "options": [ { "value": "numbers", "label": "Page numbers" }, { "value": "load_more", "label": "Load more button" }, { "value": "infinite", "label": "Infinite scroll" } ] },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true },
    { "type": "select", "id": "filter_layout", "label": "Filter layout (desktop)", "default": "sidebar", "options": [ { "value": "sidebar", "label": "Sidebar" }, { "value": "drawer", "label": "Drawer" } ] },
    { "type": "range", "id": "open_filters", "label": "Filter groups open by default", "min": 0, "max": 8, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ]
}
{% endschema %}
