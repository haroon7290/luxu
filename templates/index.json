        "q1": { "type": "question", "settings": { "question": "How do you grade condition?", "answer": "<p>Every item is graded on our six-step scale, from New to Fair, after a close inspection of the exterior, interior, corners, hardware and odour. Any marks are described and photographed in the listing.</p>" } },
        "q2": { "type": "question", "settings": { "question": "Can I see the inspection of my item?", "answer": "<p>Yes. The final check and packing of your order are recorded. You'll find a card with a personal code in your parcel — scan it to watch the recording.</p>" } },
