<cart-drawer id="CartDrawer" class="drawer drawer--right" aria-hidden="true">
  <div class="drawer__overlay" data-close></div>
  <div class="drawer__panel color-scheme-1" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div id="CartDrawer-Inner" class="drawer__inner">
      {% render 'cart-drawer-content' %}
    </div>
  </div>
</cart-drawer>
