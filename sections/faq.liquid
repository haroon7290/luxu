<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width{% if section.settings.layout == 'stacked' %} page-width--narrow{% endif %}">
    <div class="faq faq--{{ section.settings.layout }}">
      {%- capture contact -%}
        {%- if section.settings.contact_label != blank -%}
          <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="link-arrow">{{ section.settings.contact_label }} {% render 'icon', icon: 'arrow-right' %}</a>
        {%- endif -%}
      {%- endcapture -%}
      {%- assign align = 'left' -%}{%- if section.settings.layout == 'stacked' -%}{%- assign align = 'center' -%}{%- endif -%}
      <div class="section-header section-header--{{ align }}">
        <div class="section-header__copy">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="section-header__title h2 heading-italic">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}<div class="section-header__text rte">{{ section.settings.text }}</div>{%- endif -%}
          {{ contact }}
        </div>
      </div>
      <div class="accordion">
        {%- for block in section.blocks -%}
          <details class="accordion__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="accordion__summary"><span>{{ block.settings.question }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
            <div class="accordion__content rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.schema and section.blocks.size > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | strip_html | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 30,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [ { "value": "split", "label": "Heading beside questions" }, { "value": "stacked", "label": "Centred" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Questions" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A little more <em>clarity</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Everything you might want to know before choosing a pre-owned piece.</p>" },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "Ask our specialists" },
    { "type": "url", "id": "contact_link", "label": "Contact link" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "checkbox", "id": "schema", "label": "Add FAQ rich results markup (SEO)", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How do you grade condition?", "answer": "<p>Every item is graded on our six-step scale, from New to Fair, after a close inspection of the exterior, interior, corners, hardware and odour. Any marks are described and photographed in the listing.</p>" } },
        { "type": "question", "settings": { "question": "Can I see the inspection of my item?", "answer": "<p>Yes. The final check and packing of your order are recorded. You'll find a card with a personal code in your parcel — scan it to watch the recording.</p>" } },
        { "type": "question", "settings": { "question": "What does “authenticated twice” mean?", "answer": "<p>Two specialists review each piece independently, looking at materials, stitching, hardware, stamps and date codes. Both must agree before the item is listed.</p>" } },
        { "type": "question", "settings": { "question": "What if I change my mind?", "answer": "<p>You can return any item within 14 days of delivery in the condition it arrived, with all tags and accessories.</p>" } }
      ]
    }
  ]
}
{% endschema %}
