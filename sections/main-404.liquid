<section class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow not-found">
    <p class="not-found__code">404</p>
    <h1 class="h2">{{ 'templates.404.title' | t }}</h1>
    <p class="muted">{{ 'templates.404.subtext' | t }}</p>
    <button type="button" class="search-hero__form" data-open="SearchModal" style="max-width: 520px;">
      {% render 'icon', icon: 'search' %}<span class="search-hero__fake">{{ 'general.search.placeholder' | t }}</span>
    </button>
    <div class="btn-row" style="justify-content: center;">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'templates.404.link' | t }}</a>
      <a href="{{ routes.root_url }}" class="btn btn--secondary">{{ 'general.home' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 page",
  "tag": "div",
  "settings": [ { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" } ]
}
{% endschema %}
