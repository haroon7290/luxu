{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
  if section.settings.products != blank
    assign source = section.settings.products
  else
    assign source = collection.products
  endif
  assign link = section.settings.link | default: collection.url
-%}
<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <slider-component>
      {%- capture controls -%}
        <div class="slider-controls">
          <button type="button" class="icon-btn icon-btn--round" data-slider-prev aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
          <button type="button" class="icon-btn icon-btn--round" data-slider-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
        </div>
      {%- endcapture -%}
      {% render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text, link_label: section.settings.link_label, link_url: link, extra: controls %}
      <ul class="slider{% if section.settings.bleed %} slider--bleed{% endif %}" data-slider role="list" style="--per-view: {{ section.settings.per_view }}; --per-view-tablet: 2.6; --per-view-mobile: {{ section.settings.per_view_mobile }};">
        {%- if source.size > 0 -%}
          {%- for product in source limit: limit -%}
            <li class="reveal" style="--i: {{ forloop.index0 | at_most: 5 }};">{% render 'product-card', product: product, sizes: '(min-width: 990px) 22vw, (min-width: 750px) 36vw, 62vw' %}</li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..8) -%}
            <li>{% render 'product-card', index: i %}</li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      <div class="slider-progress" data-slider-progress aria-hidden="true"><span></span></div>
    </slider-component>
    {%- if section.settings.button_label != blank -%}
      <div class="text-center mt-2"><a href="{{ link | default: routes.all_products_collection_url }}" class="btn btn--secondary">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product carousel",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Curated by our specialists" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The considered <em>edit</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Or pick products", "limit": 24 },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 24, "step": 1, "default": 10 },
    { "type": "range", "id": "per_view", "label": "Cards per view (desktop)", "min": 2, "max": 6, "step": 0.5, "default": 4.5 },
    { "type": "range", "id": "per_view_mobile", "label": "Cards per view (mobile)", "min": 1, "max": 2.5, "step": 0.1, "default": 1.6 },
    { "type": "checkbox", "id": "bleed", "label": "Let cards run off the edge", "default": true },
    { "type": "text", "id": "link_label", "label": "Header link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the collection." },
    { "type": "text", "id": "button_label", "label": "Button below", "default": "Explore more finds" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "Product carousel" } ]
}
{% endschema %}
