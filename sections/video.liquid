<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width{% if section.settings.full_width %} page-width--full page-width--flush{% endif %}">
    {%- unless section.settings.full_width -%}
      {% render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text, align: 'center' %}
    {%- endunless -%}
    <site-video class="video-section reveal" style="--video-ratio: {{ section.settings.ratio }};">
      <div class="media" data-video-holder>
        {%- if section.settings.cover != blank or section.settings.video_url != blank or section.settings.video != blank -%}
          <button type="button" class="video-section__cover" data-video-play aria-label="{{ 'sections.video.play' | t }}">
            {%- if section.settings.cover != blank -%}
              {{ section.settings.cover | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750,1200,1800,2400', sizes: '100vw', alt: '' }}
            {%- elsif section.settings.video != blank -%}
              {{ section.settings.video.preview_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750,1200,1800,2400', sizes: '100vw', alt: '' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="video-section__play">{% render 'icon', icon: 'play' %}</span>
          </button>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <template>
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, controls: true, playsinline: true }}
        {%- elsif section.settings.video_url.type == 'youtube' -%}
          <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&rel=0" title="{{ section.settings.heading | strip_html | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
        {%- elsif section.settings.video_url.type == 'vimeo' -%}
          <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" title="{{ section.settings.heading | strip_html | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        {%- endif -%}
      </template>
    </site-video>
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Inside the studio" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "How a piece <em>earns</em> its place" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "video_url", "id": "video_url", "label": "Or YouTube / Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "cover", "label": "Cover image" },
    { "type": "select", "id": "ratio", "label": "Ratio", "default": "0.5625", "options": [ { "value": "0.5625", "label": "16:9" }, { "value": "0.42", "label": "Cinematic" }, { "value": "1", "label": "Square" }, { "value": "1.25", "label": "Portrait" } ] },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "Video" } ]
}
{% endschema %}
