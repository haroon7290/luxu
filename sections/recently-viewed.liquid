<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <recently-viewed data-current="{{ product.handle }}" data-limit="{{ section.settings.limit }}">
      <slider-component>
        {%- capture controls -%}
          <div class="slider-controls">
            <button type="button" class="icon-btn icon-btn--round" data-slider-prev aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
            <button type="button" class="icon-btn icon-btn--round" data-slider-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
          </div>
        {%- endcapture -%}
        {% render 'section-header', eyebrow: section.settings.eyebrow, title: section.settings.heading, extra: controls %}
        <div class="slider" data-slider data-recent-track style="--per-view: 5; --per-view-tablet: 3; --per-view-mobile: 2;"></div>
      </slider-component>
    </recently-viewed>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Shows products the visitor has viewed. Hidden until they have viewed at least one product." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Still thinking?" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Recently <em>viewed</em>" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "Recently viewed" } ]
}
{% endschema %}
