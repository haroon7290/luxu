{%- liquid
  case section.settings.height
    when 'small'
      assign h = '48vh'
    when 'medium'
      assign h = '66vh'
    when 'large'
      assign h = '84vh'
    when 'full'
      assign h = '100vh'
    else
      assign h = 'auto'
  endcase
  assign light = false
  if section.settings.text_color == 'light' and section.settings.layout != 'split'
    assign light = true
  endif
  assign img = section.settings.image
-%}
<section class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  {%- assign wrap_cls = 'page-width' -%}
  {%- if section.settings.full_width -%}{%- assign wrap_cls = 'page-width page-width--full page-width--flush' -%}{%- endif -%}
  <div class="{{ wrap_cls }}">
    <div class="banner banner--{{ section.settings.layout }}{% if section.settings.height == 'adapt' %} banner--adapt{% endif %}{% if light %} banner--light-text{% endif %} banner--image-{{ section.settings.image_position }} reveal" style="--banner-h: {{ h }}; --banner-h-mobile: {{ section.settings.mobile_height }}vh;{% if img %} --banner-ratio: {{ img.aspect_ratio }};{% endif %}{% unless section.settings.full_width %} --banner-radius: var(--radius);{% endunless %}">
      <div class="banner__media{% if section.settings.parallax %} banner__media--parallax{% endif %}"{% if section.settings.parallax %} data-parallax{% endif %}>
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1800x' }}
        {%- elsif img != blank -%}
          {%- if section.settings.image_mobile != blank -%}
            <picture>
              <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
              {{ img | image_url: width: 2800 | image_tag: loading: 'lazy', widths: '750,1100,1500,2000,2800', sizes: '100vw', alt: img.alt }}
            </picture>
          {%- else -%}
            {{ img | image_url: width: 2800 | image_tag: loading: 'lazy', widths: '750,1100,1500,2000,2800', sizes: '100vw', alt: img.alt }}
          {%- endif -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.layout != 'split' -%}<div class="banner__overlay" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }};"></div>{%- endif -%}
      </div>
      {%- if section.settings.tag != blank -%}<span class="banner__tag">{{ section.settings.tag }}</span>{%- endif -%}
      <div class="banner__content{% if section.settings.layout != 'split' %} pos-{{ section.settings.position }}{% endif %}">
        <div class="banner__copy{% if section.settings.boxed and section.settings.layout != 'split' %} banner__copy--boxed{% endif %}">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--line">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="{{ section.settings.heading_size }} heading-italic">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<div class="banner__text rte">{{ section.settings.text }}</div>{%- endif -%}
          {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
            <div class="btn-row">
              {%- assign btn_cls = 'btn--primary' -%}
              {%- if light and section.settings.boxed == false -%}{%- assign btn_cls = 'btn--light' -%}{%- endif -%}
              {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn {{ btn_cls }}">{{ section.settings.button_label }}</a>{%- endif -%}
              {%- if section.settings.button_2_label != blank -%}
                <a href="{{ section.settings.button_2_link }}" class="btn {% if light and section.settings.boxed == false %}btn--ghost-light{% else %}btn--secondary{% endif %}">{{ section.settings.button_2_label }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.link_whole and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="card__link" style="position: absolute; inset: 0; z-index: 1;" aria-label="{{ section.settings.heading | strip_html | escape }}"></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image banner",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "overlay", "options": [ { "value": "overlay", "label": "Text over image" }, { "value": "split", "label": "Image and text side by side" } ] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "video", "id": "video", "label": "Background video (replaces image)" },
    { "type": "select", "id": "image_position", "label": "Image side (split layout)", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "select", "id": "height", "label": "Height", "default": "medium", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }, { "value": "full", "label": "Full screen" }, { "value": "adapt", "label": "Adapt to image" } ] },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 70 },
    { "type": "checkbox", "id": "parallax", "label": "Parallax effect", "default": false },
    { "type": "range", "id": "overlay", "label": "Shade", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 25 },
    { "type": "select", "id": "position", "label": "Content position", "default": "middle-left", "options": [
      { "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top centre" }, { "value": "top-right", "label": "Top right" },
      { "value": "middle-left", "label": "Middle left" }, { "value": "middle-center", "label": "Middle centre" }, { "value": "middle-right", "label": "Middle right" },
      { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom centre" }, { "value": "bottom-right", "label": "Bottom right" } ] },
    { "type": "select", "id": "text_color", "label": "Text colour", "default": "light", "options": [ { "value": "light", "label": "Light" }, { "value": "scheme", "label": "From colour scheme" } ] },
    { "type": "checkbox", "id": "boxed", "label": "Show text in a box", "default": false },
    { "type": "text", "id": "tag", "label": "Round sticker", "info": "e.g. “Up to −40%”" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Seasonal sale" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The next <em>chapter</em>" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h1", "options": [ { "value": "h0", "label": "Extra large" }, { "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" } ] },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Considered reductions on pieces with stories still to tell.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the sale" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "checkbox", "id": "link_whole", "label": "Make the whole banner clickable", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [ { "name": "Image banner" } ]
}
{% endschema %}
