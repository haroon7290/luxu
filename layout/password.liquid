<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>{{ shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'meta-tags' %}

    {%- if settings.font_source == 'google' -%}
      {%- assign g_head = settings.google_heading_font | default: 'Cormorant Garamond' | strip -%}
      {%- assign g_body = settings.google_body_font | default: 'Jost' | strip -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ g_head | replace: ' ', '+' }}:{{ settings.google_heading_axes | default: 'wght@400' | strip }}&display=swap">
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ g_body | replace: ' ', '+' }}:{{ settings.google_body_axes | default: 'wght@400' | strip }}&display=swap">
      {%- capture font_heading -%}"{{ g_head }}", Georgia, serif{%- endcapture -%}
      {%- capture font_body -%}"{{ g_body }}", "Helvetica Neue", Arial, sans-serif{%- endcapture -%}
    {%- else -%}
      {%- capture font_heading -%}{{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }}{%- endcapture -%}
      {%- capture font_body -%}{{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}{%- endcapture -%}
    {%- endif -%}

    {%- style -%}
      {%- if settings.font_source == 'shopify' -%}
        {{ settings.type_header_font | font_face: font_display: 'swap' }}
        {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {%- endif -%}
      :root {
        --font-heading: {{ font_heading }};
        --font-body: {{ font_body }};
        --heading-weight: {{ settings.heading_weight }};
        --heading-transform: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};
        --eyebrow-transform: {% if settings.eyebrow_uppercase %}uppercase{% else %}none{% endif %};
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.border_radius }}px;
        --btn-radius: {{ settings.button_radius }}px;
        --btn-transform: {% if settings.button_uppercase %}uppercase{% else %}none{% endif %};
        --logo-width: {{ settings.logo_width }}px;
        --logo-width-mobile: {{ settings.logo_width_mobile }}px;
      }
      {% for scheme in settings.color_schemes -%}
        {%- assign s = scheme.settings -%}
        {% if forloop.first %}:root,{% endif %}
        .color-{{ scheme.id }} {
          --c-bg: {{ s.background }};
          --c-bg-rgb: {{ s.background.red }}, {{ s.background.green }}, {{ s.background.blue }};
          --c-gradient: {% if s.background_gradient != blank %}{{ s.background_gradient }}{% else %}{{ s.background }}{% endif %};
          --c-text: {{ s.text }};
          --c-text-rgb: {{ s.text.red }}, {{ s.text.green }}, {{ s.text.blue }};
          --c-accent: {{ s.accent }};
          --c-accent-rgb: {{ s.accent.red }}, {{ s.accent.green }}, {{ s.accent.blue }};
          --c-surface: {{ s.surface }};
          --c-btn: {{ s.button }};
          --c-btn-label: {{ s.button_label }};
          --c-btn-2: {{ s.secondary_button_label }};
        }
      {%- endfor %}
    {%- endstyle -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js'); window.theme = { routes: {}, settings: {}, strings: {} };</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" class="main-content" role="main">
      {{ content_for_layout }}
    </main>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
