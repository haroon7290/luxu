{%- comment -%} Params: article, show_excerpt, show_date, show_author {%- endcomment -%}
<article class="article-card reveal">
  <a href="{{ article.url }}" class="media zoom-on-hover" tabindex="-1" aria-hidden="true">
    {%- if article.image -%}
      {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div style="display: grid; gap: .6rem;">
    <p class="article-card__meta">
      {%- if show_date != false -%}<span>{{ article.published_at | time_tag: format: 'date' }}</span>{%- endif -%}
      {%- if show_author and article.author != blank -%}<span>{{ article.author }}</span>{%- endif -%}
      {%- if article.tags.size > 0 -%}<span>{{ article.tags.first }}</span>{%- endif -%}
    </p>
    <h3 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
    {%- if show_excerpt != false -%}
      <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 32 }}</p>
    {%- endif -%}
    <a href="{{ article.url }}" class="link-arrow">{{ 'blogs.article.read_more' | t }} {% render 'icon', icon: 'arrow-right' %}</a>
  </div>
</article>
