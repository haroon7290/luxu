{%- if section.blocks.size > 0 -%}
  <announcement-bar class="announcement color-{{ section.settings.color_scheme }} announcement--{{ section.settings.style }}" data-speed="{{ section.settings.speed }}" style="background: var(--c-gradient, var(--c-bg));" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    {%- if section.settings.style == 'marquee' -%}
      <div class="marquee__inner" style="--marquee-speed: {{ section.settings.speed | times: 8 }}s;">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            <span {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            </span>
            <span aria-hidden="true">✦</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="page-width announcement__inner">
        {%- if section.blocks.size > 1 and section.settings.show_arrows -%}
          <button type="button" class="announcement__btn" data-announce-prev aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
        {%- else -%}<span></span>{%- endif -%}
        <div class="announcement__track">
          {%- for block in section.blocks -%}
            <p class="announcement__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}{% unless forloop.first %} aria-hidden="true"{% endunless %}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </p>
          {%- endfor -%}
        </div>
        {%- if section.blocks.size > 1 and section.settings.show_arrows -%}
          <button type="button" class="announcement__btn" data-announce-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
        {%- else -%}<span></span>{%- endif -%}
      </div>
    {%- endif -%}
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 8,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" },
    { "type": "select", "id": "style", "label": "Style", "default": "slide", "options": [ { "value": "slide", "label": "Rotating" }, { "value": "marquee", "label": "Scrolling marquee" } ] },
    { "type": "range", "id": "speed", "label": "Speed", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Complimentary insured shipping over €300" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Every piece authenticated twice" } },
        { "type": "announcement", "settings": { "text": "Complimentary insured shipping over €300" } }
      ]
    }
  ]
}
{% endschema %}
